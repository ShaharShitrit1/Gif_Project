# Copy to .env.local and fill in. With no AI key the app runs in demo (mock) mode.
# Free option: a Google Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# AI_PROVIDER=gemini   # or anthropic

# Paid option (higher quality): Claude
# ANTHROPIC_API_KEY=

# Optional
# MOCK_AI=1
# CHATROAST_MODEL=claude-opus-5-5
# CHATROAST_EFFORT=high
# CHATROAST_ASK_EFFORT=medium
# CHATROAST_ACCESS_CODE=
# CHATROAST_REPORTS_PER_HOUR=6
# CHATROAST_ASKS_PER_HOUR=60
# CHATROAST_MOCK_DELAY_MS=5000
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# NEXT_PUBLIC_CONTACT_EMAIL=
